# Template sem credenciais reais. Copie para fora do Git e aplique chmod 600.
COMPOSE_PROJECT_NAME=amanda-partner-hub-hml
APP_DOMAIN=partners.example.com
APP_RUNTIME_ENV=homologacao

# Valores publicos incorporados ao bundle do navegador.
VITE_SUPABASE_URL=https://aexvrietkksxlxzztsua.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-free-project-publishable-key

# Runtime Node. Use exclusivamente o projeto Supabase Free destinado ao Hub.
SUPABASE_URL=https://aexvrietkksxlxzztsua.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-free-project-publishable-key
SB_SERVICE_ROLE_KEY=replace-on-vps-with-free-project-service-role-key

# Integracoes externas ficam desabilitadas ate configuracao e homologacao proprias.
MICROSOFT_INTEGRATION_MODE=disabled
MICROSOFT_DOC_PROCESSING_MODE=disabled
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://partners.example.com/api/public/microsoft/callback
MICROSOFT_TEST_ALLOWED_TENANT_ID=
MICROSOFT_TEST_ALLOWED_ORGANIZERS=
MICROSOFT_TEST_ALLOWED_RECIPIENTS=
MICROSOFT_DOC_PROCESSING_ALLOWED_DRIVE_ID=
MICROSOFT_DOC_PROCESSING_ALLOWED_FOLDER=
MICROSOFT_DOC_PROCESSING_TENANT_ID=
MICROSOFT_DOC_PROCESSING_CLIENT_ID=
MICROSOFT_DOC_PROCESSING_CLIENT_SECRET=
MICROSOFT_DOC_PROCESSING_SHAREPOINT_SITE_ID=
MICROSOFT_DOC_PROCESSING_SHAREPOINT_DRIVE_ID=
MICROSOFT_DOC_PROCESSING_TEMP_FOLDER=

CLICKSIGN_INTEGRATION_MODE=disabled
CLICKSIGN_AMBIENTE_ENVIO=
CLICKSIGN_API_BASE_URL=
CLICKSIGN_ACCESS_TOKEN=
CLICKSIGN_SANDBOX_ACCESS_TOKEN=
CLICKSIGN_SANDBOX_ALLOWED_RECIPIENTS=
CLICKSIGN_SANDBOX_WEBHOOK_SECRET=
CLICKSIGN_PRODUCAO_ACCESS_TOKEN=
CLICKSIGN_PRODUCAO_WEBHOOK_SECRET=
